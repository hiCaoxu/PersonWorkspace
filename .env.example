# 环境变量（复制为 .env 后修改）
# 数据库
POSTGRES_USER=pwb
POSTGRES_PASSWORD=please-change-this-password
POSTGRES_DB=personal_workbench

# 安全
# JWT 签名密钥，生成方式：openssl rand -hex 32
SECRET_KEY=please-change-this-to-a-random-64-hex-string
# 初始登录口令（首次启动写入数据库，之后改口令走界面）
ADMIN_PASSWORD=please-change-this-passcode
# 身份证 AES-256 密钥，必须 32 字节，生成方式：openssl rand -base64 32
ID_CARD_KEY=please-change-this-32-bytes-base64-key

# 运行
TZ=Asia/Shanghai
# 上传大小上限（MB）
UPLOAD_MAX_MB=10
# 每日自动生成记账/锻炼/饮食待办
DAILY_SYSTEM_TODOS=true
# 启用 HTTPS 后设为 true（Cookie 仅走加密连接）
COOKIE_SECURE=false
# Uvicorn worker 数（个人自用保持 1，避免定时任务重复调度）
UVICORN_WORKERS=1

# 对外端口
HTTP_PORT=80
